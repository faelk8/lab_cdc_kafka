{
    "name": "nome",
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "transforms": "topic_routing",
    "transforms.topic_routing.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.topic_routing.regex": ".*\\.(.*)",
    "transforms.topic_routing.replacement": "$1",
    "topic.prefix": "nome",
    "database.hostname": "************",
    "database.user": "postgres",
    "database.password": "postgrespassword",
    "database.dbname": "nome",
    "plugin.name": "pgoutput",
    "table.include.list": "tabela",
    "schema.include.list": "public"
}
